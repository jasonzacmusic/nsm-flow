<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package for NSM Flow. The __TOKENS__ are filled in by
     .github/workflows/store-package.yml from the Partner Center identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>NSM Flow</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="NSMFlow" Executable="__EXE__" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NSM Flow"
        Description="Speak and NSM Flow types for you, with music and Indian names spelled right. Runs on your computer."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start at login. TaskId must match STARTUP_TASK_ID in src-tauri/src/store_package.rs. -->
        <desktop:Extension Category="windows.startupTask" Executable="__EXE__" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NSMFlowStartup" Enabled="false" DisplayName="NSM Flow" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
